<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <ApplicationIcon>VeriFactu.ico</ApplicationIcon>
    <Version>1.0.48</Version>
    <Title>VeriFactu</Title>
    <Authors>Manuel Diago</Authors>
    <Company>Irene Solutions SL</Company>
    <Description>Generación, conservación y envío facturas VERI*FACTU</Description>
    <Copyright>Irene Solutions SL 2025</Copyright>
    <PackageProjectUrl>https://github.com/mdiago/VeriFactu</PackageProjectUrl>
    <PackageIcon>VeriFactu.png</PackageIcon>
    <RepositoryUrl>https://github.com/mdiago/VeriFactu</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>VeriFactu;Facturas;AEAT</PackageTags>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <AssemblyVersion>1.0.4.8</AssemblyVersion>
    <FileVersion>1.0.4.8</FileVersion>
    <AssemblyName>VeriFactu</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  

  <ItemGroup>
    <Content Include="VeriFactu.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="VeriFactu.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Src\Config\" />
  </ItemGroup>


  <!-- Autodiscover BackendCore.Lib.csproj under the repo root (RepoRoot defined in Directory.Build.props) -->
  <ItemGroup Condition="'$(RepoRoot)' != ''">
    <BackendCoreLibCandidates Include="$(RepoRoot)**/BackendCore.Lib.csproj" Exclude="$(RepoRoot)**/bin/**;$(RepoRoot)**/obj/**;$(RepoRoot)**/*.Tests.csproj" />
  </ItemGroup>
  
  <Target Name="ValidateBackendCoreLib" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RepoRoot)' == ''" Text="RepoRoot not defined. Ensure Directory.Build.props exists at the repo root." />
    <Error Condition="@(BackendCoreLibCandidates-&gt;Count()) == 0" Text="BackendCore.Lib.csproj not found under $(RepoRoot)." />
    <Error Condition="@(BackendCoreLibCandidates-&gt;Count()) &gt; 1" Text="Multiple BackendCore.Lib.csproj found: @(BackendCoreLibCandidates)" />
  </Target>
  
  <ItemGroup Condition="@(BackendCoreLibCandidates-&gt;Count()) == 1">
    <ProjectReference Include="@(BackendCoreLibCandidates)" />
  </ItemGroup>

</Project>
